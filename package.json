{
  "name": "focusflow",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "main": "dist/src/desktop/main.js",
  "author": "gh01wzx",
  "description": "Local-first personal tasks and project delivery.",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build",
    "review": "electron . --review",
    "prereview": "npm run build",
    "start:web": "node dist/src/main.js --open",
    "prestart:web": "npm run build",
    "package:windows": "npm run build && electron-builder --win --x64 --publish never --config electron-builder.json",
    "build": "node scripts/clean-build.ts && tsc -p tsconfig.json && tsc -p tsconfig.desktop.json && node scripts/copy-assets.ts && node scripts/build-renderer.ts",
    "typecheck": "npm run check:boundaries && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check:language": "node scripts/check-language.ts",
    "diagnose:desktop": "node scripts/diagnose-desktop.ts",
    "test": "node --test dist/test/*.test.js",
    "test:source": "node --test test/*.test.ts",
    "codex:install": "node scripts/codex-verify.ts install",
    "ai:install": "node scripts/codex-verify.ts install --product",
    "codex:login": "node scripts/codex-verify.ts login",
    "codex:status": "node scripts/codex-verify.ts status",
    "codex:probe": "node scripts/codex-verify.ts live",
    "codex:cancel": "node scripts/codex-verify.ts cancel",
    "release:candidate": "node scripts/release-candidate.ts",
    "release:verify": "node scripts/release-candidate.ts --verify"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

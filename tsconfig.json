{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "src/desktop/**",
    "scripts/build-renderer.ts",
    "scripts/smoke-today.ts",
    "scripts/smoke-review.ts",
    "scripts/project-ui.ts",
    "scripts/weekday-ui.ts",
    "scripts/smoke-install-update.ts"
  ]
}
